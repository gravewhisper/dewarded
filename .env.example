# Reddit app (type "web app") from https://www.reddit.com/prefs/apps
# Redirect URI: ${PUBLIC_URL}/auth/reddit/callback
# Leave REDDIT_CLIENT_ID empty in dev to get the dev-only fake login form.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# 32+ random bytes, e.g. `openssl rand -hex 32`. Required in production.
SESSION_SECRET=

# Origin the site is served from, no trailing slash. Used for OAuth and OpenID
# callbacks. Required in production.
PUBLIC_URL=http://localhost:3000

# libSQL URL: a local SQLite file, or libsql://<db>.turso.io for Turso.
DATABASE_URL=file:./data/medallion.db
# Only for remote libSQL (Turso).
DATABASE_AUTH_TOKEN=
